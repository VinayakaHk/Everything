{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Everything App (Debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/.build/debug/Everything",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "EVERYTHING_DEBUG_CONSOLE", "value": "1" },
                { "name": "EVERYTHING_LOG_LEVEL", "value": "debug" }
            ],
            "preLaunchTask": "Build Everything Debug"
        },
        {
            "name": "Everything Helper (Debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/.build/debug/EverythingHelper",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "EVERYTHING_DEBUG_CONSOLE", "value": "1" },
                { "name": "EVERYTHING_LOG_LEVEL", "value": "debug" }
            ],
            "preLaunchTask": "Build EverythingHelper Debug"
        },
        {
            "name": "Everything App + Helper (Debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/.build/debug/Everything",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "EVERYTHING_DEBUG_CONSOLE", "value": "1" },
                { "name": "EVERYTHING_LOG_LEVEL", "value": "debug" }
            ],
            "preLaunchTask": "Build All Debug"
        },
        {
            "name": "Run Unit Tests",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/.build/debug/EverythingUnitTests.xctest/Contents/MacOS/EverythingUnitTests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Tests Debug"
        },
        {
            "name": "Attach to Running Helper",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}",
            "preLaunchTask": "Build EverythingHelper Debug"
        }
    ],
    "compounds": [
        {
            "name": "Full Debug (App + Helper + Tests)",
            "configurations": [
                "Everything App (Debug)",
                "Everything Helper (Debug)",
                "Run Unit Tests"
            ],
            "stopAll": true
        }
    ]
}